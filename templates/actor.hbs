<div class="saga-sheet" data-class-theme="{{theme.id}}" style="{{theme.style}}">
<header class="sb-header">
<img class="sb-header-art" src="{{theme.generatorArt}}" alt="">
<img class="sb-portrait" src="{{portrait}}" data-action="editImage" data-edit="img" alt="Retrato de {{actor.name}}">
<div class="sb-identity"><span class="sb-eyebrow">{{#if isCreature}}BESTIÁRIO{{else}}BERSERKR · {{theme.title}}{{/if}}</span><input class="sb-name" name="name" value="{{actor.name}}" aria-label="Nome"><div class="sb-identity-fields"><label>Classe<select name="system.className">{{#each classChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Reino<input name="system.realm" value="{{system.realm}}"></label></div></div>
</header>
<div class="sb-layout">
<aside class="sb-overview" aria-label="Recursos e atributos">
<section class="sb-vitals"><h2>Recursos</h2>
<div class="sb-vital"><img src="systems/berserkr-rpg/assets/icons-ink/hp.png" alt=""><div><label>PV</label><div class="sb-pair"><input type="number" name="system.hp.value" value="{{system.hp.value}}" aria-label="PV atuais"><span>/</span><input type="number" name="system.hp.max" min="0" value="{{system.hp.max}}" aria-label="PV máximos"></div></div></div>
<div class="sb-vital"><img src="systems/berserkr-rpg/assets/icons-ink/destinos.png" alt=""><div><label>Destinos</label><div class="sb-pair"><input type="number" name="system.destinos.value" value="{{system.destinos.value}}" aria-label="Destinos atuais"><span>/</span><input type="number" name="system.destinos.max" min="0" value="{{system.destinos.max}}" aria-label="Destinos máximos"></div></div></div>
<div class="sb-vital"><img src="systems/berserkr-rpg/assets/icons-ink/runes.png" alt=""><div><label>Usos rúnicos</label><div class="sb-pair"><input type="number" name="system.runes.value" value="{{system.runes.value}}" aria-label="Usos rúnicos atuais"><span>/</span><input type="number" name="system.runes.max" min="0" value="{{system.runes.max}}" aria-label="Usos rúnicos máximos"></div></div></div>
<button type="button" class="sb-subtle" data-action="spendDestiny">Gastar 1 Destino</button>
</section>
<section class="sb-attributes"><h2>Atributos</h2><p class="sb-help">Clique no nome para rolar.</p>{{#each attributes}}<div class="sb-attribute"><button type="button" data-action="rollAttribute" data-attribute="{{key}}"><img src="systems/berserkr-rpg/assets/icons-ink/{{key}}.png" alt=""><span>{{label}}</span></button><input type="number" name="system.attributes.{{key}}" value="{{value}}" aria-label="{{label}}"></div>{{/each}}</section>
<div class="sb-load"><span><img class="sb-inline-icon" src="systems/berserkr-rpg/assets/icons-ink/load.png" alt=""> Carga <strong>{{load}} / {{capacity}}</strong></span>{{#if overloaded}}<small class="sb-warning">Carga excedida</small>{{/if}}</div>
</aside>
<div class="sb-main">
<nav class="sb-tabs" role="tablist" aria-label="Seções da ficha">{{#each sheetTabs}}<button type="button" role="tab" id="{{../tabScope}}-tab-{{id}}" aria-controls="{{../tabScope}}-panel-{{id}}" aria-selected="{{active}}" data-sheet-tab="{{id}}" class="{{#if active}}selected{{/if}}"><img src="systems/berserkr-rpg/assets/icons-ink/{{icon}}.png" alt=""><span>{{label}}</span>{{#if count}}<small>{{count}}</small>{{/if}}</button>{{/each}}</nav>
<div class="sb-library-tools" hidden><label class="sb-search-label">Buscar nesta aba<input type="search" data-catalog-search placeholder="Nome ou descrição…" autocomplete="off" aria-label="Buscar nesta aba"></label><span data-catalog-count aria-live="polite"></span></div>
<div class="sb-panels">
<section class="sb-panel" role="tabpanel" id="{{tabScope}}-panel-combat" aria-labelledby="{{tabScope}}-tab-combat" data-sheet-panel="combat" tabindex="0">
<div class="sb-page-title"><h2>Combate</h2><span>Ações e proteção</span></div>

<div class="sb-combat-grid"><section class="sb-box"><h3>Armas</h3><button type="button" class="sb-unarmed" data-action="automate" data-operation="attack">Ataque desarmado</button>{{#each weapons}}<article class="sb-ready"><img src="{{img}}" alt=""><div><button type="button" class="sb-item-name" data-action="editItem" data-item-id="{{id}}">{{name}}</button><small>{{damage}}{{#if equipped}} · equipada{{/if}}{{#if broken}} · quebrada{{/if}}</small></div><button type="button" class="sb-primary" data-action="automate" data-operation="attack" data-item-id="{{id}}">Atacar</button></article>{{else}}<p class="sb-help">Sem armas. Adicione uma na aba Equipamentos.</p>{{/each}}</section>
<section class="sb-box sb-defense"><h3>Proteção</h3><div class="sb-protection">{{#each equippedArmors}}<div class="sb-protection-item"><img src="{{img}}" alt=""><button type="button" class="sb-item-name" data-action="editItem" data-item-id="{{id}}">{{name}}</button></div>{{else}}<div class="sb-protection-item"><img src="systems/berserkr-rpg/assets/icons-ink/armor.png" alt=""><strong>Sem armadura</strong></div>{{/each}}</div><div class="sb-defense-actions"><button type="button" data-action="automate" data-operation="defense">Defender</button><button type="button" data-action="automate" data-operation="parry">Aparar</button></div><button type="button" class="sb-damage-action" data-action="automate" data-operation="damage">Receber dano</button><details class="sb-defense-settings"><summary>Ajustar dificuldade</summary><label>CD dos testes<input type="number" name="system.defenseDC" min="0" value="{{system.defenseDC}}"></label>{{#if isCreature}}<label>Bônus à defesa dos PJs<input type="number" name="system.defenseBonus" min="0" value="{{system.defenseBonus}}"></label>{{/if}}</details></section></div>
<section class="sb-box sb-status"><h3><img src="systems/berserkr-rpg/assets/icons-ink/fortitude.png" alt="">Condições</h3><p class="sb-help">Clique para ativar ou remover.</p><div class="sb-conditions">{{#each conditions}}<button type="button" data-action="automate" data-operation="condition" data-status="{{id}}" aria-pressed="{{active}}">{{#if active}}✓ {{/if}}{{label}}</button>{{/each}}</div>{{#each effects}}<div class="sb-effect"><span>{{name}}{{#if remaining}} · {{remaining}} turnos{{/if}}</span><button type="button" data-action="automate" data-operation="effect" data-effect-id="{{id}}" aria-label="Remover {{name}}">×</button></div>{{/each}}{{#if hemorrhage}}<p class="sb-warning">Hemorragia: {{hemorrhage}} horas até morte sem tratamento.</p><button type="button" data-action="automate" data-operation="treatment">Registrar tratamento</button>{{/if}}</section>
<section class="sb-box sb-rest"><h3><img src="systems/berserkr-rpg/assets/icons-ink/hp.png" alt="">Descansos</h3><div class="sb-inline-actions"><button type="button" data-action="automate" data-operation="short"><strong>Descanso curto</strong><small>Uma pausa na jornada</small></button><button type="button" data-action="automate" data-operation="long"><strong>Descanso longo</strong><small>Recuperação entre jornadas</small></button></div></section>
<details class="sb-details"><summary>Controle de turnos e sessões</summary><div class="sb-inline-actions"><button type="button" data-action="automate" data-operation="tick">Avançar efeitos: 1 turno</button><button type="button" data-action="automate" data-operation="combat">Novo combate</button><button type="button" data-action="automate" data-operation="session">Nova sessão</button></div></details>
</section>
<section class="sb-panel" role="tabpanel" id="{{tabScope}}-panel-equipment" aria-labelledby="{{tabScope}}-tab-equipment" data-sheet-panel="equipment" tabindex="0" hidden>
<div class="sb-page-title"><h2>Equipamentos</h2><div class="sb-inline-actions"><button type="button" data-action="createItem" data-type="weapon">+ Arma</button><button type="button" data-action="createItem" data-type="armor">+ Armadura</button><button type="button" data-action="createItem" data-type="equipment">+ Item</button></div></div>
<div class="sb-wallet"><label><img class="sb-inline-icon" src="systems/berserkr-rpg/assets/icons-ink/coins.png" alt=""> Bugigangas<input type="number" name="system.bugigangas" min="0" value="{{system.bugigangas}}"></label><span><img class="sb-inline-icon" src="systems/berserkr-rpg/assets/icons-ink/load.png" alt=""> Carga <strong>{{load}} / {{capacity}}</strong></span><small>Arraste itens do compêndio para esta ficha.</small></div>
<div class="sb-filters" aria-label="Filtrar equipamentos"><button type="button" data-catalog-filter="all" aria-pressed="true">Todos</button><button type="button" data-catalog-filter="weapon" aria-pressed="false">Armas</button><button type="button" data-catalog-filter="armor" aria-pressed="false">Armaduras</button><button type="button" data-catalog-filter="equipment" aria-pressed="false">Suprimentos</button><button type="button" data-catalog-filter="equipped" aria-pressed="false">Equipados</button></div>
<div class="sb-catalog">{{#each equipment}}<article class="sb-catalog-card" data-catalog-card data-catalog-text="{{searchText}}" data-item-kind="{{kind}}" data-item-equipped="{{equipped}}"><img class="sb-card-icon" src="{{img}}" alt=""><div class="sb-card-content"><button type="button" class="sb-item-name" data-action="editItem" data-item-id="{{id}}">{{name}}</button><div class="sb-card-meta"><span>{{typeLabel}}</span><span>× {{quantity}}</span><span>{{slots}} espaço(s)</span>{{#if equipped}}<span class="sb-badge">Equipado</span>{{/if}}{{#if broken}}<span class="sb-warning">Quebrado</span>{{/if}}</div><p class="sb-card-description">{{description}}</p><div class="sb-card-actions">{{#if weapon}}<button type="button" class="sb-primary" data-action="automate" data-operation="attack" data-item-id="{{id}}">Atacar</button><button type="button" data-action="rollDamage" data-item-id="{{id}}">Dano</button>{{/if}}{{#if canEquip}}<button type="button" data-action="automate" data-operation="equip" data-item-id="{{id}}">{{#if equipped}}Desequipar{{else}}Equipar{{/if}}</button>{{/if}}{{#if uses}}<button type="button" data-action="automate" data-operation="consume" data-item-id="{{id}}">Consumir · {{uses}}</button>{{/if}}{{#if broken}}<button type="button" data-action="automate" data-operation="repair" data-item-id="{{id}}">Reparar</button>{{/if}}<button type="button" data-action="editItem" data-item-id="{{id}}">Detalhes</button><button type="button" data-action="postItem" data-item-id="{{id}}">Chat</button><button type="button" class="sb-delete" data-action="deleteItem" data-item-id="{{id}}" aria-label="Excluir {{name}}" title="Excluir">×</button></div></div></article>{{else}}<p class="sb-empty">Seu inventário está vazio. Adicione uma arma, armadura ou item.</p>{{/each}}</div><p class="sb-empty" data-catalog-empty hidden>Nenhum equipamento corresponde à busca.</p>
</section>
<section class="sb-panel" role="tabpanel" id="{{tabScope}}-panel-abilities" aria-labelledby="{{tabScope}}-tab-abilities" data-sheet-panel="abilities" tabindex="0" hidden>
<div class="sb-page-title"><h2>Habilidades</h2><div class="sb-inline-actions"><button type="button" data-action="createItem" data-type="ability">+ Habilidade</button><button type="button" data-action="createItem" data-type="class">+ Classe</button></div></div>
<div class="sb-catalog">{{#each abilities}}<article class="sb-catalog-card" data-catalog-card data-catalog-text="{{searchText}}"><img class="sb-card-icon" src="{{img}}" alt=""><div class="sb-card-content"><button type="button" class="sb-item-name" data-action="editItem" data-item-id="{{id}}">{{name}}</button><div class="sb-card-meta"><span>{{typeLabel}}</span></div><p class="sb-card-description">{{description}}</p><div class="sb-card-actions">{{#if ability}}<button type="button" class="sb-primary" data-action="automate" data-operation="ability" data-item-id="{{id}}">Usar habilidade</button>{{/if}}<button type="button" data-action="editItem" data-item-id="{{id}}">Ler regra</button><button type="button" data-action="postItem" data-item-id="{{id}}">Chat</button><button type="button" class="sb-delete" data-action="deleteItem" data-item-id="{{id}}" aria-label="Excluir {{name}}" title="Excluir">×</button></div></div></article>{{else}}<p class="sb-empty">Adicione sua classe e habilidades pelo compêndio.</p>{{/each}}</div><p class="sb-empty" data-catalog-empty hidden>Nenhuma habilidade corresponde à busca.</p>
</section>
<section class="sb-panel" role="tabpanel" id="{{tabScope}}-panel-runes" aria-labelledby="{{tabScope}}-tab-runes" data-sheet-panel="runes" tabindex="0" hidden>
<div class="sb-page-title"><h2>Runas</h2><button type="button" data-action="createItem" data-type="rune">+ Runa</button></div><p class="sb-help">Ative um feitiço ou inscreva uma pedra em equipamento. Os usos diários ficam na coluna de recursos.</p>
<div class="sb-catalog">{{#each runes}}<article class="sb-catalog-card" data-catalog-card data-catalog-text="{{searchText}}"><img class="sb-card-icon" src="{{img}}" alt=""><div class="sb-card-content"><button type="button" class="sb-item-name" data-action="editItem" data-item-id="{{id}}">{{name}}</button><div class="sb-card-meta"><span>{{modeLabel}}</span></div><p class="sb-card-description">{{description}}</p><div class="sb-card-actions">{{#if canActivateRune}}<button type="button" class="sb-primary" data-action="automate" data-operation="rune" data-item-id="{{id}}">Ativar runa</button>{{/if}}{{#if canInscribe}}<button type="button" data-action="automate" data-operation="inscribe" data-item-id="{{id}}">Inscrever</button>{{/if}}<button type="button" data-action="editItem" data-item-id="{{id}}">Ler regra</button><button type="button" data-action="postItem" data-item-id="{{id}}">Chat</button><button type="button" class="sb-delete" data-action="deleteItem" data-item-id="{{id}}" aria-label="Excluir {{name}}" title="Excluir">×</button></div></div></article>{{else}}<p class="sb-empty">Adicione pedras rúnicas pelo compêndio.</p>{{/each}}</div><p class="sb-empty" data-catalog-empty hidden>Nenhuma runa corresponde à busca.</p>
</section>
<section class="sb-panel" role="tabpanel" id="{{tabScope}}-panel-notes" aria-labelledby="{{tabScope}}-tab-notes" data-sheet-panel="notes" tabindex="0" hidden>
<div class="sb-page-title"><h2>Saga e notas</h2><span>Sua história nos Nove Reinos</span></div><label class="sb-note-label">Saga<textarea name="system.saga" rows="5" placeholder="Feitos, promessas e conquistas…">{{system.saga}}</textarea></label><label class="sb-note-label">História e anotações<textarea name="system.biography" rows="7" placeholder="Origem, vínculos e acontecimentos da jornada…">{{system.biography}}</textarea></label><label class="sb-note-label">Fonte<input name="system.source" value="{{system.source}}"></label>
</section>
</div></div></div>
</div>
