<div class="berserkr-body wizard-body" data-class-theme="{{theme.id}}" style="{{theme.style}}">
<header class="wizard-header"><img class="wizard-header-art" src="{{theme.generatorArt}}" alt=""><div><p class="brand">BERSERKR · FORJE SUA SAGA</p><h2>{{stepTitle}}</h2><p class="wizard-subtitle">Etapa {{stepNumber}} de 5 · {{theme.title}}</p></div></header><ol class="wizard-track">{{#each steps}}<li class="{{#if current}}current{{/if}} {{#if done}}done{{/if}}" {{#if current}}aria-current="step"{{/if}}><b>{{#if done}}✓{{else}}{{number}}{{/if}}</b><span>{{label}}</span></li>{{/each}}</ol><div class="wizard-content">
{{#unless stepClass}}<aside class="wizard-saga"><img src="{{theme.generatorArt}}" alt=""><div><span>SUA SAGA</span><strong>{{selectedClass.name}}</strong><small>{{selectedClass.system.realm}} · {{theme.title}}</small></div><img class="saga-emblem" src="{{theme.emblem}}" alt=""></aside>{{/unless}}<p class="hint">O rascunho fica salvo. Conclua cada etapa antes de avançar.</p>
{{#if stepClass}}
<section class="wizard-panel"><h3>Escolha sua origem</h3><div class="class-grid">{{#each classes}}<button type="button" class="choice class-choice {{#if selected}}selected{{/if}}" aria-pressed="{{selected}}" data-action="selectClass" data-id="{{id}}"><span class="class-art-frame" style="{{theme.generatorPortrait}}"><img class="class-art" src="{{theme.generatorArt}}" alt="Ilustração de {{name}}"></span><strong>{{name}}</strong><small>{{realm}}</small></button>{{/each}}</div></section>
{{#if selectedClass}}<section class="wizard-panel class-intro"><img class="class-intro-art" src="{{theme.generatorArt}}" alt="{{theme.name}}"><div class="class-intro-copy"><h3>{{selectedClass.name}}</h3><p class="theme-motif">{{theme.motif}}</p><p>Classe de {{selectedClass.system.realm}}. Sua característica é recebida automaticamente; escolha uma habilidade inicial.</p><button type="button" data-action="openItem" data-id="{{selectedClass.id}}">Ler classe completa</button><p>PV: {{selectedClass.system.hpFormula}} · Destinos: {{selectedClass.system.destinyFormula}}</p><p>{{selectedClass.system.startingEquipment}}</p></div></section>
<section class="wizard-panel"><h3>Escolha uma habilidade</h3><p class="hint">A característica da classe é recebida automaticamente. Escolha uma das seis habilidades ou sorteie.</p>{{#if passive}}<button type="button" data-action="openItem" data-id="{{passive.id}}">Ler característica: {{passive.name}}</button>{{/if}}<button type="button" data-action="randomSkill">Sortear habilidade · 1d6</button><div class="skill-grid">{{#each skills}}<button type="button" class="choice skill-choice {{#if selected}}selected{{/if}}" aria-pressed="{{selected}}" data-action="selectSkill" data-id="{{id}}"><strong>{{name}}</strong><small>{{description}}</small></button>{{/each}}</div></section>{{/if}}
{{/if}}
{{#if stepAttributes}}<p>Role 3d6, some o bônus da classe e converta o total para o modificador usado em jogo.</p><button type="button" data-action="rollAll">Rolar os cinco atributos</button><section class="wizard-panel"><h3>Atributos de {{selectedClass.name}}</h3>{{#each attributes}}<div class="attribute-row"><strong>{{label}}</strong><span>Bônus de criação: {{bonusLabel}}</span>{{#if rolled}}<span>{{dice}} = {{raw}} · {{bonusLabel}} = {{total}}</span><b>Modificador: {{value}}</b>{{else}}<span>Ainda não rolado</span><b>—</b>{{/if}}<button type="button" data-action="rollAttribute" data-attribute="{{key}}">Rolar</button></div>{{/each}}</section><p class="hint">Voltar e trocar a classe reinicia atributos e recursos. Rerrolar atributos exige rolar os recursos novamente.</p>{{/if}}
{{#if stepResources}}<button type="button" data-action="rollResources">Rolar PV, Destinos e recursos iniciais</button><section class="wizard-panel"><h3>Dados da sua classe</h3>{{#each resourceRows}}<div class="resource-row"><strong>{{label}}</strong><span>{{formula}}</span><b>{{#if ../hasResources}}{{value}}{{else}}—{{/if}}</b></div>{{/each}}</section><p class="hint">PV têm mínimo 1. O limite rúnico é d4 + Astúcia, limitado a zero se a soma for negativa.</p>{{/if}}
{{#if stepEquipment}}
<button type="button" data-action="rollEquipment">Sortear equipamento inicial</button><p>Equipamento da classe: {{starterNames}}</p>
<section class="wizard-panel"><h3>Transporte e arma adicional</h3><label>Forma de transportar<select name="transport" data-equipment><option value="">Escolha</option><option value="hands" {{#if hands}}selected{{/if}}>Mãos vazias — recebe uma Runa</option><option value="pouch" {{#if pouch}}selected{{/if}}>Algibeira de Couro — 7 itens</option><option value="sack" {{#if sack}}selected{{/if}}>Saco de Tecido — 10 itens</option></select></label>
<label>Arma inicial<select name="weapon" data-equipment><option value="">Escolha</option>{{#each weapons}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><p class="hint">Esta arma é adicional às armas da classe.</p>
<label>{{#if hasClassArmor}}Armadura concedida pela classe{{else}}Armadura inicial{{/if}}<select name="armor" data-equipment><option value="">Escolha</option>{{#each armors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label></section>
<section class="wizard-panel"><h3>Dois itens iniciais</h3><label>Primeiro<select name="first" data-equipment><option value="">Escolha</option>{{#each first}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Segundo<select name="second" data-equipment><option value="">Escolha</option>{{#each second}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label></section>
{{#each runeChoices}}<section class="wizard-panel"><h3>{{label}}</h3><select name="rune-{{index}}" data-equipment><option value="">Escolha uma Runa</option>{{#each choices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></section>{{/each}}
<p class="hint">Runas do Mestre Ferreiro servem somente para inscrição; as do Arrasa-Reinos somente como feitiços. As Runas extras não recebem essas restrições.</p>
{{/if}}
{{#if stepPersonal}}<section class="wizard-panel"><h3>Quem terá esta Saga?</h3><label>Nome obrigatório<input name="name" value="{{draft.name}}" required></label><label>História e aparência<textarea name="biography" rows="6">{{draft.biography}}</textarea></label></section><section class="wizard-panel"><h3>Revisão</h3><p>{{selectedClass.name}} · {{selectedClass.system.realm}}</p><p>{{selectedSkill.name}}</p><p>{{summary}}</p><p>PV {{draft.resources.hp}} · Destinos {{draft.resources.destinos}} · Runas {{draft.resources.runes}} · {{draft.resources.coins}}‡</p><p>{{selectedClass.system.startingEquipment}}</p><div class="review-equipment">{{#each selectedEquipment}}<button type="button" data-action="openItem" data-id="{{id}}">{{name}}</button>{{/each}}</div><p>Tema da ficha: <strong>{{theme.name}} · {{theme.title}}</strong></p></section><p class="hint">Ao finalizar, um novo ator completo será criado. A ficha de origem será preservada.</p>{{/if}}
</div><footer class="generator-controls"><span class="wizard-save-note">Rascunho salvo automaticamente</span>{{#if canBack}}<button type="button" data-action="back">Voltar</button>{{/if}}{{#if isLast}}<button type="button" data-action="finish">Gerar personagem</button>{{else}}<button type="button" data-action="next" {{#unless canAdvance}}disabled{{/unless}}>Próxima etapa</button>{{/if}}</footer>
</div>
