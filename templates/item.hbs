<div class="berserkr-body ink-sheet ink-item" data-class-theme="{{theme.id}}" style="{{theme.style}}"><header class="hero" style="background-image:linear-gradient(90deg,var(--theme-bg) 45%,transparent),url('{{theme.generatorArt}}')"><img src="{{itemArtwork}}" data-action="editImage" data-edit="img" alt="Imagem"><div><p class="brand">BERSERKR · {{typeLabel}}</p><input name="name" value="{{item.name}}" aria-label="Nome do item"></div></header><section class="ink-panel"><h3 class="ink-section-title">Dados</h3><div class="grid three"><label>Quantidade<input type="number" min="0" name="system.quantity" value="{{system.quantity}}"></label><label>Espaços por unidade<input type="number" min="0" name="system.slots" value="{{system.slots}}"></label><label>Preço<input type="number" min="0" name="system.price" value="{{system.price}}"></label></div><label class="check"><input type="checkbox" name="system.equipped" {{checked system.equipped}}> Equipado</label></section>{{#if weapon}}<section class="ink-panel"><h3 class="ink-section-title">Arma</h3><label>Fórmula de dano<input name="system.damage" value="{{system.damage}}" placeholder="1d6"></label><label>Atributo de ataque<select name="system.attribute">{{selectOptions attributeOptions selected=system.attribute}}</select></label></section>{{/if}}{{#if armor}}<section class="ink-panel"><h3 class="ink-section-title">Armadura</h3><label>Categoria<input type="number" min="0" name="system.category" value="{{system.category}}"></label><label>Redução de dano<input name="system.reduction" value="{{system.reduction}}"></label><label>Penalidade de Agilidade (valor positivo)<input type="number" min="0" name="system.agilityPenalty" value="{{system.agilityPenalty}}"></label></section>{{/if}}{{#if isClass}}<section class="ink-panel"><h3 class="ink-section-title">Criação de personagem</h3><p class="hint">Some estes bônus a 3d6 e converta o total. Não são bônus diretos nos Testes.</p><div class="grid five">{{#each classModifiers}}<label>{{label}}<input type="number" name="system.classModifiers.{{key}}" value="{{value}}"></label>{{/each}}</div><label>PV iniciais — fórmula<input name="system.hpFormula" value="{{system.hpFormula}}"></label><label>Destinos iniciais — fórmula<input name="system.destinyFormula" value="{{system.destinyFormula}}"></label><label>Equipamento inicial<textarea name="system.startingEquipment" rows="4">{{system.startingEquipment}}</textarea></label></section><section class="ink-panel"><h3 class="ink-section-title">Característica e habilidades</h3>{{#each features}}<button type="button" data-action="openFeature" data-uuid="{{uuid}}">{{name}}</button>{{/each}}</section>{{/if}}{{#if rune}}<section class="ink-panel"><h3 class="ink-section-title">Feitiço</h3><textarea name="system.spell" rows="5">{{system.spell}}</textarea></section><section class="ink-panel"><h3 class="ink-section-title">Inscrição</h3><textarea name="system.inscription" rows="5">{{system.inscription}}</textarea></section>{{/if}}<section class="ink-panel"><h3 class="ink-section-title">Descrição e regras</h3><textarea name="system.description" rows="12">{{system.description}}</textarea></section><label>Fonte<input name="system.source" value="{{system.source}}"></label><button type="button" data-action="postDescription">Enviar descrição ao chat</button><section class="ink-panel"><h3 class="ink-section-title">Automação</h3><label>Usos consumíveis<input type="number" min="0" name="system.uses" value="{{system.uses}}"></label><label>Cura ao consumir<input name="system.healing" value="{{system.healing}}" placeholder="1d4"></label>{{#if weapon}}<label><input type="checkbox" name="system.broken" {{checked system.broken}}> Arma quebrada</label>{{/if}}{{#if rune}}<label>Modo<select name="system.runeMode">{{selectOptions runeModes selected=system.runeMode}}</select></label><p class="hint">Inscrições são criadas pelo botão Inscrever na ficha do portador.</p>{{/if}}</section></div>